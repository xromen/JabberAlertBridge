{
  "Urls": "http://0.0.0.0:8080",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=jabber_alert_bridge;Username=jabber_bridge;Password=CHANGE_ME;Timeout=5;Command Timeout=10"
  },
  "Xmpp": {
    "Host": "jabber.company.local",
    "Port": 5222,
    "Jid": "monitoring@company.local",
    "Password": "CHANGE_ME",
    "RoomJid": "alerts@conference.company.local",
    "Nickname": "Monitoring Bot",
    "RoomPassword": "",
    "RequireTls": true,
    "ValidateCertificate": false,
    "ConnectTimeoutSeconds": 15,
    "PingIntervalSeconds": 30
  },
  "WebhookAuth": {
    "Username": "monitoring",
    "Password": "CHANGE_ME"
  },
  "Delivery": {
    "PollIntervalSeconds": 2,
    "SendTimeoutSeconds": 20,
    "LeaseDurationSeconds": 60,
    "RetryInitialSeconds": 5,
    "RetryMaxSeconds": 300,
    "MaxPendingMessages": 5000,
    "MaxAttempts": 0,
    "MessageRetentionDays": 14,
    "DeadRetentionDays": 90
  },
  "AlertFormatting": {
    "TimeZoneId": "Asia/Vladivostok",
    "MaxMessageLength": 4000,
    "MaxAlertsPerRequest": 100,
    "MaxRequestBodyBytes": 262144,
    "IncludeLinks": true,
    "SendResolved": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "None"
    }
  }
}
