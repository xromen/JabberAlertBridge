# Local Docker Compose configuration. Copy to .env and replace placeholders.
JABBER_ALERT_DB_PASSWORD=CHANGE_ME
JABBER_ALERT_XMPP_HOST=jabber.company.local
JABBER_ALERT_XMPP_JID=monitoring@company.local
JABBER_ALERT_XMPP_PASSWORD=CHANGE_ME
JABBER_ALERT_XMPP_ROOM=alerts@conference.company.local
JABBER_ALERT_XMPP_NICKNAME=Monitoring Bot
JABBER_ALERT_XMPP_ROOM_PASSWORD=
JABBER_ALERT_WEBHOOK_USERNAME=monitoring
JABBER_ALERT_WEBHOOK_PASSWORD=CHANGE_ME
# Used only by deploy/compose.dockprom.yml for an existing PostgreSQL server.
JABBER_ALERT_POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=jabber_alert_bridge;Username=jabber_bridge;Password=CHANGE_ME;Timeout=5;Command Timeout=10
JABBER_ALERT_DOCKER_NETWORK=monitor-net
